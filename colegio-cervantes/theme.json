{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": false,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{
					"slug": "azul",
					"name": "Azul Cervantes",
					"color": "#00325A"
				},
				{
					"slug": "oro",
					"name": "Oro",
					"color": "#D39A47"
				},
				{
					"slug": "rojo",
					"name": "Rojo",
					"color": "#BB0923"
				},
				{
					"slug": "gris-claro",
					"name": "Gris claro",
					"color": "#F1F1F1"
				},
				{
					"slug": "amarillo",
					"name": "Amarillo",
					"color": "#FFD200"
				},
				{
					"slug": "blanco",
					"name": "Blanco",
					"color": "#FFFFFF"
				},
				{
					"slug": "texto",
					"name": "Texto",
					"color": "#1A1A1A"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "lama-sans",
					"name": "Lama Sans",
					"fontFamily": "\"Lama Sans\", \"LamaSans\", system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "poppins",
					"name": "Poppins",
					"fontFamily": "'Poppins', sans-serif"
				}
			]
		},
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1200px"
		},
		"spacing": {
			"blockGap": null
		}
	},
	"styles": {
		"color": {
			"background": "#ffffff",
			"text": "#1a1a1a"
		},
		"typography": {
			"fontFamily": "'Poppins', sans-serif"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"right": "0",
				"bottom": "0",
				"left": "0"
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Encabezado",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Pie de página",
			"area": "footer"
		}
	]
}