{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "cervantes/icon",
	"title": "Ícono Cervantes",
	"category": "design",
	"icon": "star-filled",
	"description": "Ícono decorativo con el estilo del colegio. Elegí el dibujo y el estilo desde el panel lateral.",
	"keywords": [ "icono", "ícono", "icon", "cervantes" ],
	"textdomain": "colegio-cervantes",
	"attributes": {
		"icon": { "type": "string", "default": "estrella" },
		"variant": { "type": "string", "default": "suave" },
		"size": { "type": "number", "default": 56 }
	},
	"supports": {
		"html": false,
		"align": [ "left", "center", "right" ],
		"spacing": { "margin": true }
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
