# Copiá este archivo como ".env" y completá los valores.

# Puerto donde corre la web
PORT=3000

# Dirección pública de la web (sin barra final). En producción tiene que ser https.
BASE_URL=http://localhost:3000

# Contraseña del panel de administración (/admin). Sin esto el panel queda deshabilitado.
ADMIN_PASSWORD=cambiame-por-una-clave-larga

# Mercado Pago: Access Token de la cuenta del negocio.
# Se obtiene en https://www.mercadopago.com/developers/panel/app
# Si se deja vacío, la tienda solo ofrece "transferencia por WhatsApp".
MP_ACCESS_TOKEN=

# Moneda (UYU pesos uruguayos, ARS pesos argentinos, etc.)
CURRENCY=UYU

# Envío: costo fijo y monto a partir del cual es gratis
SHIPPING_COST=90
FREE_SHIPPING_FROM=1500

# Datos del local que se muestran en la web
STORE_PHONE=099 123 456
STORE_WHATSAPP=59899123456
STORE_ADDRESS=Av. Ejemplo 1234, Montevideo
STORE_HOURS=Lunes a sábado de 8 a 20 h
