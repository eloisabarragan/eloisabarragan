{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{ "slug": "marino", "name": "Azul marino", "color": "#1E3246" },
				{ "slug": "celeste", "name": "Celeste", "color": "#559FCF" },
				{ "slug": "grafito", "name": "Grafito", "color": "#3F4348" },
				{ "slug": "niebla", "name": "Niebla", "color": "#F3F6F9" },
				{ "slug": "blanco", "name": "Blanco", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fontFamilies": [
				{ "slug": "display", "name": "Títulos", "fontFamily": "'Plus Jakarta Sans', system-ui, sans-serif" },
				{ "slug": "body", "name": "Texto", "fontFamily": "'Inter', system-ui, sans-serif" }
			]
