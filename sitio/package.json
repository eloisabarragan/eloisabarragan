{
  "name": "altura-estudio-capital",
  "private": true,
  "version": "1.0.0",
  "description": "Sitio web: estudio contable, inversiones y real estate premium en Uruguay",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=assets/app.js && esbuild src/styles.css --bundle --minify --external:fonts/* --outfile=assets/styles.css",
    "dev": "npm run build && npx --yes serve ."
  },
  "dependencies": {
    "gsap": "3.12.5",
    "lenis": "1.1.13",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@fontsource-variable/outfit": "^5.1.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "esbuild": "0.24.0"
  }
}
